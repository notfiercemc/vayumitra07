# GEMINI_API_KEY: Required for Gemini AI environmental assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# OPENAQ_API_KEY: Optional OpenAQ v3 API key for higher rate limits on ground sensor data.
# When omitted, VayuMitra automatically uses Open-Meteo Air Quality Copernicus data.
OPENAQ_API_KEY=""

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key (falls back to Open-Meteo Forecast API).
OPENWEATHER_API_KEY=""

# PORT: Express server port (defaults to 3000)
PORT="3000"
